{
  "openapi": "3.1.0",
  "info": {
    "title": "Reset Radar public announcement API",
    "version": "1.0.0",
    "description": "公开只读；不证明个人额度到账。时间为 UTC，原帖和事件 ID 为字符串。"
  },
  "servers": [
    {
      "url": "https://radar.shadowearth.cn"
    }
  ],
  "paths": {
    "/api/v1/status": {
      "get": {
        "operationId": "getResetStatus",
        "summary": "当前有效预告与最近完成公告",
        "responses": {
          "200": {
            "description": "成功；无预告和过期快照通过业务字段表达",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "api_version",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "api_version": {
                      "const": "1"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "latest_forecast",
                        "active_forecast",
                        "forecast_status",
                        "latest_completed"
                      ],
                      "properties": {
                        "latest_forecast": {
                          "anyOf": [
                            {
                              "$ref": "#/components/schemas/Event"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "active_forecast": {
                          "anyOf": [
                            {
                              "$ref": "#/components/schemas/Event"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "latest_completed": {
                          "anyOf": [
                            {
                              "$ref": "#/components/schemas/Event"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "forecast_status": {
                          "enum": [
                            "active",
                            "none",
                            "elapsed",
                            "unknown"
                          ]
                        }
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "事件不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "请求过多；Retry-After 60 秒",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "快照不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "operationId": "listResetEvents",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "事件类型",
            "schema": {
              "enum": [
                "reset",
                "credit"
              ]
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "当前事件状态",
            "schema": {
              "enum": [
                "announced",
                "scheduled",
                "completed",
                "cancelled",
                "unconfirmed"
              ]
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "activity_at 严格晚于此时间，不是本站首次收录时间",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页条数",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "分页游标，保持相同筛选条件；不提供跨页快照或变化流保证",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功；无预告和过期快照通过业务字段表达",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "api_version",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "api_version": {
                      "const": "1"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Event"
                          }
                        },
                        "next_cursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "filters": {
                          "type": "object"
                        }
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "事件不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "请求过多；Retry-After 60 秒",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "快照不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events/{id}": {
      "get": {
        "operationId": "getResetEvent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功；无预告和过期快照通过业务字段表达",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "api_version",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "api_version": {
                      "const": "1"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Event"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "事件不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "请求过多；Retry-After 60 秒",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "快照不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Event": {
        "type": "object",
        "required": [
          "event_id",
          "type",
          "state",
          "activity_at",
          "source_urls"
        ],
        "properties": {
          "expected_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "deadline_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "effective_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "forecast_announced_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completed_announced_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "event_id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "reset",
              "credit"
            ]
          },
          "state": {
            "enum": [
              "announced",
              "scheduled",
              "completed",
              "cancelled",
              "unconfirmed"
            ]
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "activity_at": {
            "type": "string",
            "format": "date-time"
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "time_kind": {
            "enum": [
              "point",
              "deadline",
              "unknown"
            ]
          },
          "time_quote": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "post_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "text_zh": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "role": {
                  "type": "string"
                },
                "category": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "Meta": {
        "type": "object",
        "required": [
          "generated_at",
          "source_status",
          "analysis_status"
        ],
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "source_last_success_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "source_status": {
            "enum": [
              "fresh",
              "stale",
              "unavailable"
            ]
          },
          "analysis_status": {
            "enum": [
              "up_to_date",
              "pending",
              "unavailable"
            ]
          },
          "freshness_seconds": {
            "type": "integer"
          },
          "coverage_note": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "api_version": {
            "const": "1"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
